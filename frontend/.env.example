# `pnpm dev` only: the dev server proxies /api/* here. In production the static
# build is served by nginx, which proxies /api/* to the container's BACKEND_URL.
BACKEND_URL=http://localhost:8080

# Show the email dev-login form on /login (backend must run with AUTH_DEV_LOGIN=true).
# Inlined at build time.
NEXT_PUBLIC_DEV_LOGIN=false
