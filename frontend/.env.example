# Server-side: where the Go backend lives. /api/* is proxied here at request time,
# and Server Components fetch from it directly (forwarding the session cookie).
BACKEND_URL=http://localhost:8080

# Serve the whole API from in-process MSW handlers (no backend needed).
NEXT_PUBLIC_API_MOCKING=disabled

# Show the email dev-login form on /login (backend must run with AUTH_DEV_LOGIN=true).
NEXT_PUBLIC_DEV_LOGIN=false
