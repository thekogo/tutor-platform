# Copy to .env and adjust. .env is git-ignored; never commit real secrets.
# docker compose reads this file automatically; for local (non-docker) dev,
# export it into your shell, e.g. `set -a; source .env; set +a`.

# ---------------------------------------------------------------------------
# PostgreSQL (docker compose `db` service)
# ---------------------------------------------------------------------------
POSTGRES_USER=tutor
POSTGRES_PASSWORD=tutor
POSTGRES_DB=tutor
# Host port for Postgres. 5433 avoids clashing with a local Postgres on 5432.
POSTGRES_HOST_PORT=5433

# Host ports for the app containers.
BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# ---------------------------------------------------------------------------
# Backend (Go)
# ---------------------------------------------------------------------------
# Connection string used by the backend when run on the host (make dev-db + go run).
# Inside docker compose the backend uses the `db` hostname instead (set in docker-compose.yml).
DATABASE_URL=postgres://tutor:tutor@localhost:5433/tutor?sslmode=disable

# Separate database for integration tests (`make test`). Optional; tests that need
# Postgres are skipped when unset.
TEST_DATABASE_URL=postgres://tutor:tutor@localhost:5433/tutor?sslmode=disable

# Listen address for REST (/api), MCP (/mcp) and probes (/healthz, /readyz).
HTTP_ADDR=:8080

# Public URL of the web app. Used for OAuth redirects back to the UI, invite links,
# and the Origin check on state-changing requests.
APP_BASE_URL=http://localhost:3000
# Comma-separated Origins allowed on state-changing requests (CSRF guard).
# Empty = APP_BASE_URL only. "*" allows any Origin, e.g. while testing through
# an ngrok tunnel — do not use "*" in production.
ALLOWED_ORIGINS=

# Google OIDC (invite-only login). Create an OAuth client at
# https://console.cloud.google.com/apis/credentials (type: Web application).
# Leave empty in dev and use AUTH_DEV_LOGIN instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be registered in the Google console. Goes through the frontend /api proxy.
GOOGLE_REDIRECT_URL=http://localhost:3000/api/auth/google/callback

# Set the session cookie's Secure flag. MUST be true in production (HTTPS).
# false is fine for http://localhost.
SESSION_COOKIE_SECURE=false

# Enables POST /api/auth/dev-login {email,name} (no Google). Local dev and e2e ONLY.
# MUST be false in production.
AUTH_DEV_LOGIN=true

# Bearer token for the MCP endpoint (/mcp), used by the Owner's Claude agent.
# Acts as Content Admin. Generate a strong one: `openssl rand -hex 32`.
MCP_TOKEN=dev-mcp-token-change-me

# debug | info | warn | error
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Frontend (Next.js)
# ---------------------------------------------------------------------------
# Server-side URL the Next.js server uses to reach the backend (and to proxy /api).
# Host dev: http://localhost:8080   docker compose: http://backend:8080 (set in compose)
BACKEND_URL=http://localhost:8080

# true = serve mocked API responses in the browser (frontend-only dev, no backend).
NEXT_PUBLIC_API_MOCKING=false

# true = show the dev-login form on the login page. Requires AUTH_DEV_LOGIN=true on the backend.
# NEXT_PUBLIC_* values are inlined at build time.
NEXT_PUBLIC_DEV_LOGIN=true

# ---------------------------------------------------------------------------
# E2E (Playwright, e2e/)
# ---------------------------------------------------------------------------
E2E_BASE_URL=http://localhost:3000
# MCP endpoint + token the e2e setup uses to create test Questions.
E2E_MCP_URL=http://localhost:8080/mcp
E2E_MCP_TOKEN=e2e-mcp-token
